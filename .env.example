# Optional. Leave unset for guest mode (progress in the browser only).
# Create a free project at https://supabase.com, run supabase/schema.sql in its
# SQL editor, then copy the project URL and anon (public) key from
# Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional. The public address confirmation emails and GitHub sign-in should
# return to, e.g. https://netlab.example. Leave it unset to use whatever origin
# the page is being served from, which is right for local development and for
# the production domain. Set it when that origin is not one of the redirect URLs
# allowed in Supabase, such as on a preview deployment.
VITE_SITE_URL=
